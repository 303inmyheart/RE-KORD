{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RE-KORD",
  "identifier": "app.rekord.client",
  "build": {
    "beforeDevCommand": "pnpm --filter @rekord/client-ui dev",
    "devUrl": "http://localhost:7422",
    "beforeBuildCommand": "pnpm --filter @rekord/client-ui build",
    "frontendDist": "../../client-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RE-KORD",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http: https: data: blob:",
        "media-src": "'self' http: https: data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost http: https: data: blob:",
        "worker-src": "'self' blob:",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http: https: data: blob:",
        "media-src": "'self' http: https: data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost http: https: data: blob: ws: wss:",
        "worker-src": "'self' blob:",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "wix": null
    },
    "android": {
      "minSdkVersion": 26
    }
  },
  "plugins": {}
}
