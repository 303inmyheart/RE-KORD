{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RE-KORD Server",
  "mainBinaryName": "rekord-server-app",
  "identifier": "app.rekord.server",
  "build": {
    "beforeBuildCommand": "pnpm --filter @rekord/client-ui build && pnpm --filter @rekord/server-ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RE-KORD Server",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "resources": {
      "../../server-ui/dist/": "admin-ui/",
      "../../client-ui/dist/": "client-ui/"
    }
  }
}
