target/
node_modules/
dist/
.DS_Store
*.db
*.db-*
.vite/
# `gen/*` and not `gen/`: with the trailing slash git skips the folder without
# entering it, and the exception below would never even be read.
apps/client-shell/src-tauri/gen/*
# Exception: the native Android project is version-controlled. We edit it by hand
# (manifest permissions, foreground service for audio) and `tauri android init`
# would regenerate it from scratch on every machine, wiping those changes. The parts
# the CLI rewrites on every build — .so files, the assets' tauri.conf.json,
# tauri.build.gradle.kts — stay excluded by the .gitignore files inside gen/android.
!apps/client-shell/src-tauri/gen/android/
apps/client-shell/src-tauri/target/
release/
.env
.env.*

# docker-compose.yml volumes (test data and music)
docker-data/

# Local editor / assistant state
.cursor/
.claude/
