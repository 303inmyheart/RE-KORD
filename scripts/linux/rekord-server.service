# RE-KORD hub as a systemd service.
#
# Installation (see docs/DEPLOY.md, or scripts/linux/install.sh, which performs these steps):
#   sudo useradd --system --home /var/lib/rekord --shell /usr/sbin/nologin rekord
#   sudo mkdir -p /opt/rekord /var/lib/rekord && sudo chown rekord:rekord /var/lib/rekord
#   sudo tar -xzf rekord-server-*-linux-*.tar.gz -C /opt/rekord --strip-components=1
#   sudo cp /opt/rekord/systemd/rekord-server.service /etc/systemd/system/
#   sudo cp /opt/rekord/systemd/rekord-server.env /etc/default/rekord-server   # then edit it
#   sudo systemctl daemon-reload && sudo systemctl enable --now rekord-server
#
# Log: journalctl -u rekord-server -f
[Unit]
Description=RE-KORD music hub
Documentation=https://re-kord.com
Wants=network-online.target
After=network-online.target local-fs.target remote-fs.target

[Service]
Type=simple
User=rekord
Group=rekord
EnvironmentFile=-/etc/default/rekord-server
ExecStart=/opt/rekord/run.sh
Restart=on-failure
RestartSec=5
# The hub closes the DB cleanly on SIGTERM.
KillSignal=SIGTERM
TimeoutStopSec=20

# Hardening: the hub writes only to the data folder and (Studio, downloads,
# cover art) to the music library, which must be added to ReadWritePaths.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
StateDirectory=rekord
ReadWritePaths=/var/lib/rekord
# Library on an external disk or in /home? Add it here (and remove
# ProtectHome=read-only if it lives in /home and must be writable):
# ReadWritePaths=/srv/music

[Install]
WantedBy=multi-user.target
