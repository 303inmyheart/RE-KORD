# /etc/default/rekord-server — read by the systemd unit rekord-server.service.
# Same variables as the rekord-server command line (rekord-server --help).

# Listen address. 0.0.0.0 = reachable on the LAN; 127.0.0.1 = this machine only.
REKORD_BIND=0.0.0.0:7420

# Database, settings, accounts, module manifest.
REKORD_DATA_DIR=/var/lib/rekord

# Music library (Artist/Album/track). It can also be chosen from the /admin panel.
#REKORD_MUSIC_ROOT=/srv/music

# Optional
#REKORD_ALLOW_REMOTE_ADMIN=0
#REKORD_WATCH_LIBRARY=1
# Keep the computer from sleeping: off, always, when-active (locks the admin
# panel's choice). Needs systemd/50-rekord-power.rules in /etc/polkit-1/rules.d/.
#REKORD_PREVENT_SLEEP=when-active
#REKORD_ALLOWED_ORIGINS=https://musica.example.org
#REKORD_PUBLIC_URL=https://musica.example.org
#ENABLE_YTDLP=1
#YTDLP_PATH=/opt/rekord/bin/yt-dlp
#REKORD_CLOUDFLARED_BIN=/opt/rekord/bin/cloudflared
#RUST_LOG=info,tower_http=info
