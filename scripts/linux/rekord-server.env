# /etc/default/rekord-server — letto dall'unita' systemd rekord-server.service.
# Stesse variabili della riga di comando di rekord-server (rekord-server --help).

# Indirizzo di ascolto. 0.0.0.0 = raggiungibile in LAN; 127.0.0.1 = solo questa macchina.
REKORD_BIND=0.0.0.0:7420

# Database, impostazioni, account, manifest dei moduli.
REKORD_DATA_DIR=/var/lib/rekord

# Libreria musicale (Artista/Album/brano). Si puo' anche scegliere dal pannello /admin.
#REKORD_MUSIC_ROOT=/srv/music

# Facoltativi
#REKORD_ALLOW_REMOTE_ADMIN=0
#REKORD_WATCH_LIBRARY=1
#REKORD_ALLOWED_ORIGINS=https://musica.example.org
#REKORD_PUBLIC_URL=https://musica.example.org
#ENABLE_YTDLP=1
#YTDLP_PATH=/opt/rekord/bin/yt-dlp
#REKORD_CLOUDFLARED_BIN=/opt/rekord/bin/cloudflared
#RUST_LOG=info,tower_http=info
